<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <startup> 
        <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
    </startup>
	<connectionStrings>
	<!-- SQL Server Express 2022 Connection String -->
	<!-- Update the Server name and Database name according to your setup -->
	<add name="DefaultConnection"
		 connectionString="Server=.\SQLEXPRESS;Database=POSSystemDB;Integrated Security=true;TrustServerCertificate=true;"
		 providerName="System.Data.SqlClient" />

	<!-- Alternative connection string with SQL Server Authentication -->
	<!-- <add name="DefaultConnection" 
             connectionString="Server=.\SQLEXPRESS;Database=POSSystemDB;User Id=sa;Password=yourpassword;TrustServerCertificate=true;" 
             providerName="System.Data.SqlClient" /> -->
	</connectionStrings>

	<appSettings>
		<!-- Application specific settings -->
		<add key="CompanyName" value="Your Company Name" />
		<add key="ApplicationTitle" value="POS System - Point of Sale" />
		<add key="Version" value="1.0.0" />
	</appSettings>
</configuration>